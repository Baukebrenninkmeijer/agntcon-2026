#!/bin/sh
# Rebuild slides/evaluation-flywheel.html whenever one of its sources is staged, so the
# committed deck never lags the generator it came from.
set -e

sources=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '^slides/(build_deck\.py|.*\.json)$' || true)
[ -n "$sources" ] || exit 0

make deck >/dev/null
git add slides/evaluation-flywheel.html
